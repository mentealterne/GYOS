# Copy to .env, which git ignores, and adjust. pnpm dev (apps/api) reads it. Other commands read
# your shell's environment: export what they need, for example `set -a; . ./.env; set +a`.
# The URLs match docker-compose.yml.

# development turns on readable logs; production writes JSON lines.
NODE_ENV=development
PORT=3000
# fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=debug

# Until the product has authentication, the tenant of a request comes from the x-tenant-id header
# (apps/api/src/http/tenant.ts). That is NOT authentication: any caller can name any tenant. It is
# on by default outside production; a host with NODE_ENV=production refuses to start with it.
# TENANT_FROM_HEADER=true

# The database the app runs on. ready() migrates every module's schema here.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/product

# The database the integration tests drop and recreate schemas in. Its name must contain "test":
# the tests refuse any other.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/product_test
