{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {},
    "test:unit": {},
    "test:scenarios": {
      "outputs": ["reports/**"]
    },
    "test:integration": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    }
  }
}
